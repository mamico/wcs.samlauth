<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      i18n:domain="plone">

        <div class="row">
            <p class="documentDescription">
                Only IDP and SP informations is updated automatically.
            </p>
            <metal:form use-macro="context/@@ploneform-macros/titlelessform">
                <metal:slot fill-slot="fields">
                    <div tal:content="structure view/widgets/metadata_url/@@ploneform-render-widget" />
                    <div tal:content="structure view/widgets/metadata_file/@@ploneform-render-widget" />
                    <metal:block use-macro="context/@@ploneform-macros/actions"/>

                    <div class="idp-data" tal:condition="view/idp_data">
                        <pre><code tal:content="structure view/formatted_idp_metadata" /></pre>
                    </div>
                </metal:slot>
                <metal:slot fill-slot="actions" />
            </metal:form>
        </div>

        <div class="row" style="margin-top: 2em; border-top: 1px solid #ddd; padding-top: 1em;">
            <h2>Auto-refresh</h2>
            <dl class="dl-horizontal">
                <dt>Metadata URL</dt>
                <dd tal:content="python: context.getProperty('metadata_url') or '—'" />

                <dt>Auto-refresh</dt>
                <dd tal:condition="context/metadata_auto_refresh">
                    Enabled — interval: <span tal:content="context/metadata_refresh_interval" /> seconds
                </dd>
                <dd tal:condition="not: context/metadata_auto_refresh">Disabled</dd>

                <dt>Last refresh</dt>
                <dd tal:content="python: context.getProperty('metadata_last_refreshed') or 'never'" />
            </dl>

            <p tal:condition="context/metadata_url">
                <a class="btn btn-default"
                   tal:attributes="href string:${context/absolute_url}/@@refresh_idp_metadata">
                    Refresh now
                </a>
            </p>
            <p class="discreet">
                Auto-refresh and interval can be configured via the plugin properties (ZMI).
            </p>
        </div>
</html>
